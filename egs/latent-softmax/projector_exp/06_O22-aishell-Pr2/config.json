{
    "train_config": {
        "num_beam_samples": 0,
        "num_multinomial_samples": 8,
        "s2p_temperature": 1.0,
        "simplified": true
    },
    "s2p2g_tokenizer_config": {
        "llm_tokenizer_path": "data/Qwen/Qwen3-1.7B-base"
    },
    "projector_config": {
        "freeze": true,
        "speech_embedding_dim": 512,
        "projector_hidden_dim": 4096,
        "llm_embedding_dim": 2048,
        "k": 5
    },
    "s2p_encoder": {
        "type": "ConformerNet",
        "freeze": true,
        "kwargs": {
            "num_cells": 18,
            "idim": 80,
            "hdim": 512,
            "conv": "vgg2l",
            "num_heads": 8,
            "d_head": 64,
            "dropout": 0.3,
            "dropout_attn": 0.3,
            "kernel_size": 32,
            "n_classes": 63
        }
    },
    "beamDecoder": {
        "type": "CTCBeamDecoder",
        "n_classes": 63,
        "beam_width": 16,
        "log_probs_input": true,
        "num_processes": 2
    },
    "p2g_model": {
        "type": "LLMFromPretrainedModel",
        "freeze": false,
        "kwargs": {
            "pretrained_model_name_or_path": "data/Qwen/Qwen3-1.7B-base",
            "from_pretrained": true,
            "attention_dropout": 0.1
        },
        "lora": {
            "part_module_name": "q_proj^k_proj^v_proj^o_proj",
            "lora_dim": 1024,
            "lora_scaling": 2048
        }
    },
    "scheduler": {
        "type": "SchedulerCosineAnnealingWithWarmup",
        "kwargs": {
            "min_lr": 1e-05,
            "stop_step": 9000,
            "warmup_steps": 2000
        },
        "optimizer": {
            "type": "Adam",
            "kwargs": {
                "lr": 8e-05,
                "betas": [
                    0.9,
                    0.98
                ],
                "weight_decay": 1e-06
            }
        }
    }
}